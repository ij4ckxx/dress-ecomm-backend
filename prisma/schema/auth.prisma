enum Role {
  CUSTOMER
  STAFF
  STORE_ADMIN
  SUPER_ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  name          String
  avatarUrl     String?
  phone         String?
  role          Role           @default(CUSTOMER)
  permissions   String[]       @default([])
  isActive      Boolean        @default(true)
  createdById   String?
  creator       User?          @relation("UserHierarchy", fields: [createdById], references: [id])
  createdUsers  User[]         @relation("UserHierarchy")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts      Account[]
  refreshTokens RefreshToken[]
  wishlist      Wishlist?
  carts         Cart[]
  inventoryTransactions InventoryTransaction[]

  @@index([email])
  @@index([role])
  @@index([createdById])
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // e.g. "google", "facebook", "github"
  providerAccountId String   // unique user ID returned by provider
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userAgent  String?
  ipAddress  String?

  @@index([userId])
}
