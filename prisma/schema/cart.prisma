enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum MetafieldValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model Cart {
  id         String          @id @default(uuid())
  customerId String?
  user       User?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestToken String?         @unique
  status     CartStatus      @default(ACTIVE)
  currency   String          @default("INR")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  items      CartItem[]
  metafields CartMetafield[]

  @@index([customerId, status])
  @@index([guestToken])
  @@index([status])
  @@index([createdAt])
}

model CartItem {
  id            String               @id @default(uuid())
  cartId        String
  cart          Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity      Int                  @default(1)

  // Price snapshots (Decimal 10,2 for accurate financial records)
  unitPrice     Decimal              @db.Decimal(10, 2)
  regularPrice  Decimal              @db.Decimal(10, 2)
  salePrice     Decimal?             @db.Decimal(10, 2)
  offerPrice    Decimal?             @db.Decimal(10, 2)
  modifierTotal Decimal              @default(0) @db.Decimal(10, 2)
  lineTotal     Decimal              @db.Decimal(10, 2)

  // Configuration hash for item uniqueness & race condition prevention
  configHash    String

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  modifiers     CartItemModifier[]
  metafields    CartItemMetafield[]

  @@unique([cartId, configHash])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model CartItemModifier {
  id               String         @id @default(uuid())
  cartItemId       String
  cartItem         CartItem       @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifierOptionId String
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)
  priceDelta       Decimal        @default(0) @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())

  @@unique([cartItemId, modifierOptionId])
  @@index([cartItemId])
  @@index([modifierOptionId])
}

model CartMetafield {
  id        String             @id @default(uuid())
  cartId    String
  cart      Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  namespace String
  key       String
  value     String
  valueType MetafieldValueType @default(STRING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([cartId, namespace, key])
  @@index([cartId])
  @@index([namespace, key])
}

model CartItemMetafield {
  id         String             @id @default(uuid())
  cartItemId String
  cartItem   CartItem           @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  namespace  String
  key        String
  value      String
  valueType  MetafieldValueType @default(STRING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([cartItemId, namespace, key])
  @@index([cartItemId])
  @@index([namespace, key])
}
