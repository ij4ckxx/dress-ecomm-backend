// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TestItem {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}
