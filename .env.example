# ==============================================================================
# 1. SERVER & APP CONFIGURATION (MANDATORY)
# ==============================================================================
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# ==============================================================================
# 2. DATABASE CONFIGURATION - PostgreSQL (MANDATORY)
# ==============================================================================
# For Neon Serverless PostgreSQL:
# DATABASE_URL is the pooled connection string (with -pooler)
DATABASE_URL="postgresql://user:password@ep-sweet-shadow-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL is the direct connection string (without -pooler, used for migrations)
DIRECT_URL="postgresql://user:password@ep-sweet-shadow.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# 3. AUTHENTICATION & SECURITY (MANDATORY)
# ==============================================================================
# Generate strong 64-character random strings (e.g. via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_super_secret_cookie_signing_string

# Legacy compatibility fallback if using single secret:
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# ==============================================================================
# 4. E-COMMERCE STORE, PRICING & SHIPPING DEFAULTS (OPTIONAL / OVERRIDABLE VIA ADMIN UI)
# ==============================================================================
# Flat delivery fee on any cart containing items (default: 150.00 INR)
DEFAULT_FLAT_SHIPPING_RATE=150.00

# Free shipping order threshold (default: 2999.00 INR)
DEFAULT_FREE_SHIPPING_THRESHOLD=2999.00

# Cash on Delivery maximum order value limit (default: 25000.00 INR)
DEFAULT_COD_MAX_LIMIT=25000.00

# Store Currency
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹

# ==============================================================================
# 5. PAYMENT GATEWAYS & DIRECT UPI QR CONFIGURATION (OPTIONAL / OVERRIDABLE VIA ADMIN UI)
# ==============================================================================
# Toggle payment method availability defaults
ENABLE_RAZORPAY=true
ENABLE_COD=true
ENABLE_UPI_QR=true

# Direct UPI QR Details for Customer Bank Transfer / Dynamic QR
DEFAULT_UPI_ID=maison@okhdfcbank
DEFAULT_UPI_PAYEE_NAME="Maison De Élégance"
DEFAULT_UPI_INSTRUCTIONS="Scan the QR code or tap 'Pay via UPI App', then enter your 12-digit UPI Reference / UTR Number below to confirm."

# Razorpay Test / Live Keys (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ==============================================================================
# 6. CLOUDINARY (MANDATORY FOR PRODUCT & BANNER IMAGES)
# ==============================================================================
# Free 25 Credits/Month (~25 GB storage & 25,000 transformations)
# Sign up free at: https://cloudinary.com
# Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# 7. INITIAL SUPER ADMIN SEEDING (OPTIONAL / SETUP)
# ==============================================================================
DEFAULT_ADMIN_NAME="Super Admin"
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# ==============================================================================
# 8. NOTIFICATION SERVICES & SMTP EMAIL (OPTIONAL / PRODUCTION)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SUPPORT_EMAIL=concierge@maisondeelegance.com
WHATSAPP_API_TOKEN=

# ==============================================================================
# 9. CRON JOBS & MAINTENANCE
# ==============================================================================
TOKEN_CLEANUP_CRON="0 */6 * * *"
