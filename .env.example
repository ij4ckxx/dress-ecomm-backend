# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/maison_elegance?schema=public"

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret

# Payment Gateways
# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Notification Services (Optional / Future)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHATSAPP_API_TOKEN=

# Cloudinary (Free Cloud Image Storage - No local disk storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Credentials (For initial seed/setup)
DEFAULT_ADMIN_EMAIL=admin@maison-elegance.com
DEFAULT_ADMIN_PASSWORD=Password123!
